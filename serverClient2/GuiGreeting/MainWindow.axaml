<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GuiGreeting.MainWindow"
        Title="Сетевое приложение (GUI)">
    <Grid Margin="10" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button x:Name="BtnStartServer" Content="Запустить Сервер" Click="BtnStartServer_Click"/>
            <Button x:Name="BtnConnect" Content="Подключиться как Клиент" Click="BtnConnect_Click"/>
        </StackPanel>
        
        <TextBox Grid.Row="1" x:Name="TxtLog" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"/>
                 
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <TextBox x:Name="TxtMessage" Width="300" PlaceholderText="Введите сообщение..."/>
            <Button x:Name="BtnSend" Content="Отправить" Click="BtnSend_Click"/>
        </StackPanel>
    </Grid>
</Window>